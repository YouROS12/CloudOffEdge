# Paper 2 deploy environment overrides.
# Copy to deploy/config/.env on each device. Loaded by systemd via EnvironmentFile=.

# --- Edge device (Raspberry Pi) ---
DEPLOY_ROLE=edge
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
EDGE_DEVICE=cpu
MARGIN_THRESHOLD=0.20
# Replace with your Jetson's Tailscale MagicDNS name or 100.x.y.z address:
CLOUD_URL=http://my-jetson:8001

# --- Cloud device (Jetson Nano) ---
# Comment-out the edge block and uncomment this on the Jetson:
# DEPLOY_ROLE=cloud
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8001
# CLOUD_DEVICE=cuda
# CLOUD_SEQUENTIAL=1

# --- Dashboard (every node, edge AND cloud, posts here) ---
# Replace with your laptop's Tailscale MagicDNS name. Leave empty to disable.
DASHBOARD_URL=http://my-laptop:9000
# NODE_ID=                   # optional override; default is hostname
# HEARTBEAT_INTERVAL_S=15

# --- Dashboard host (laptop only) ---
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=9000
# HEARTBEAT_TIMEOUT_S=60     # mark node offline after this many seconds w/o heartbeat
